# Copy this file to .dev.vars and fill in your values
# This file should NOT be committed to version control

# Password for guest authentication
AUTH_PASSWORD=your-secret-password-here

# External blog posts endpoint (optional)
CODE_ENDPOINT=https://code.charliegleason.com

# External records collection endpoint (optional)
RECORDS_ENDPOINT=https://records.charliegleason.com

# Nylon Impossible API token for the homepage's "Working on" list (optional)
# Create one in Nylon → Settings → API token
NYLON_TOKEN=nyl_your-token-here
