---
/**
 * Dynamic route for public case studies.
 * 
 * Loads content from apps/web/src/content/work/
 * Protected case studies are injected as separate routes by the protected-routes integration.
 */

// Get the slug from params
const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

// Eager, so the dev server sees the content components as static imports and collects their scoped CSS
// (the layout's background grid among it); a lazy glob left those styles off the page in dev.
const modules = import.meta.glob<{ default: astroHTML.JSX.Element }>("../../content/work/*.astro", { eager: true });
const modulePath = `../../content/work/${slug}.astro`;

if (!modules[modulePath]) {
  return Astro.redirect("/404");
}

const ContentComponent = modules[modulePath].default;
---

<ContentComponent />
