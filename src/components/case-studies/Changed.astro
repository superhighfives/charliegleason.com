---
// Media in the content column with a "What changed" note beside it in the right rail, which follows
// the reader down past the media. Below xl the note sits under the media instead. The note sits in a
// 1px gradient frame, with its title set into the top edge.
interface Props {
  gradient: string;
}

const { gradient } = Astro.props;
---

<div class="full grid grid-cols-subgrid gap-y-8 xl:gap-y-16">
  <div class="col-[rail-start/main-end] xl:col-[main-start/content-start] xl:row-start-1 flex flex-col gap-8 xl:gap-16">
    <slot />
  </div>
  <aside class="changed relative col-[rail-start/main-end] xl:col-[content-start/rail-end] xl:row-start-1 xl:ml-4 mt-3 self-start xl:sticky xl:top-20 not-prose rounded-lg px-5 pt-6 pb-5">
    <span aria-hidden="true" class:list={["changed-frame absolute inset-0 rounded-lg p-px bg-gradient-to-r pointer-events-none", gradient]}></span>
    <h3 class="absolute -top-2.5 left-4 px-2 bg-white dark:bg-neutral-900 leading-5">
      <span class:list={["text-sm font-display uppercase tracking-wider text-transparent bg-clip-text bg-gradient-to-r", gradient]}>What changed</span>
    </h3>
    <div class="relative text-sm leading-relaxed text-neutral-600 dark:text-neutral-300 space-y-3 [&_a]:underline [&_a]:underline-offset-2 [&_a]:text-neutral-900 dark:[&_a]:text-white">
      <slot name="note" />
    </div>
  </aside>
</div>

<style>
  /* Keep only the 1px edge of the gradient. */
  .changed-frame {
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
  }
</style>
