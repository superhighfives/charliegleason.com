---
// A code block whose background runs the full width of the page, with the code itself starting on
// the same line as the prose around it and scrolling out to the right edge. Highlighted at build time
// with sugar-high, so no JavaScript ships for it.
import { highlight, type LanguageName } from "sugar-high";

interface Props {
  code: string;
  lang?: LanguageName;
}

const { code, lang = "shell" } = Astro.props;
const html = highlight(code, { lang });
---

<div class="code-band full not-prose grid grid-cols-subgrid -my-2 xl:-my-8 bg-neutral-100 dark:bg-neutral-950 border-y border-neutral-200 dark:border-neutral-800 max-sm:border-x max-sm:rounded-lg">
  <pre class="col-[rail-start/main-end] sm:col-[rail-start/full-end] xl:col-[main-start/full-end] overflow-x-auto py-8 pr-8 max-sm:py-5 max-sm:px-4 font-mono text-sm leading-7 text-neutral-800 dark:text-neutral-200"><code set:html={html} /></pre>
</div>

<style>
  .code-band {
    --sh-identifier: theme("colors.neutral.800");
    --sh-property: theme("colors.neutral.600");
    --sh-sign: theme("colors.neutral.400");
    --sh-comment: theme("colors.neutral.400");
    --sh-class: theme("colors.amber.700");
    --sh-entity: theme("colors.amber.700");
    --sh-keyword: #c2416b;
    --sh-string: theme("colors.emerald.700");
    --sh-jsxliterals: theme("colors.neutral.800");
  }

  :global(.dark) .code-band {
    --sh-identifier: theme("colors.neutral.200");
    --sh-property: theme("colors.neutral.400");
    --sh-sign: theme("colors.neutral.500");
    --sh-comment: theme("colors.neutral.500");
    --sh-class: theme("colors.yellow.400");
    --sh-entity: theme("colors.yellow.400");
    --sh-keyword: #e45c87;
    --sh-string: theme("colors.emerald.400");
    --sh-jsxliterals: theme("colors.neutral.200");
  }

  .code-band :global(.sh__token--comment) {
    font-style: italic;
  }
</style>
