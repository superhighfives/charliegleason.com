---
import Icon from "./Icon.astro";
import {
  LINK_BASE_CLASSES,
  LINK_GROUP_STATE_CLASSES,
  LINK_STATE_CLASSES,
} from "../../lib/link-styles";

const iconMap = {
  back: "arrow-left",
  forward: "arrow-right",
} as const;

interface Props {
  type?: 'default' | 'text';
  size?: 'default' | 'large';
  padding?: 'default' | 'large';
  class?: string;
  background?: boolean;
  icon?: keyof typeof iconMap;
  href?: string;
  // Render as a span that takes its hover/focus/active states from the nearest
  // `group` ancestor, for when the whole surrounding card is the link.
  tag?: 'a' | 'span';
}

const {
  type = 'default',
  size = 'default',
  padding = 'default',
  class: className = '',
  background = true,
  icon,
  href,
  tag = 'a',
} = Astro.props;

const textClasses = `
  transition-colors outline-2 outline-offset-2 rounded-sm border-b border-neutral-900/25 dark:border-neutral-100/25 mx-0.5
  hover:text-yellow-600 dark:hover:text-yellow-400 hover:border-current dark:hover:border-current
  focus:text-yellow-600 dark:focus:text-yellow-400 focus:border-current dark:focus:border-current
  active:text-yellow-600 dark:active:text-yellow-400 active:border-current dark:active:border-current
  focus-visible:outline focus-visible:outline-yellow-600 focus-visible:dark:outline-yellow-400
  truncate
`;



const sizeClasses = size === 'large' ? 'sm:text-md md:text-lg' : '';
const backgroundClasses = !background ? 'bg-none bg-white dark:bg-neutral-900 rounded-md' : 'rounded-sm';
const paddingClasses = padding === 'large' ? 'px-2 py-1 -my-0.5' : '';
---

{tag === 'span' ? (
  <span
    class:list={[LINK_BASE_CLASSES, LINK_GROUP_STATE_CLASSES, sizeClasses, backgroundClasses, paddingClasses, className, icon ? 'inline-flex items-center' : 'inline']}
  >
    {icon && <Icon name={iconMap[icon]} weight="bold" class="w-4 mx-auto inline mr-2" />}
    <slot />
  </span>
) : type === 'text' ? (
  <a
    href={href}
    class:list={[textClasses, className]}
  >
    <slot />
  </a>
) : (
  <a
    href={href}
    class:list={[LINK_BASE_CLASSES, LINK_STATE_CLASSES, sizeClasses, backgroundClasses, paddingClasses, className, icon ? 'inline-flex items-center' : 'inline']}
  >
    {icon && <Icon name={iconMap[icon]} weight="bold" class="w-4 mx-auto inline mr-2" />}
    <slot />
  </a>
)}
